# Canonical site URL used for canonical links, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://itvidya.com

# A real, monitored contact address. Leave unset until one exists — the site then
# shows a clearly labelled placeholder and never pretends to submit forms.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.org

# Public share link of the "Contact Us" Notion Form (from Notion: open the form view,
# Share form → "Anyone with the link" → Copy link). Shown embedded on /contact.
# NEXT_PUBLIC_NOTION_FORM_URL=https://your-workspace.notion.site/...
